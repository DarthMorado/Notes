@using DarthNotes.Web.Extensions
@model NotesListModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}


@foreach(var note in Model)
{
    <form asp-controller="Notes" method="GET" asp-route-id="@note.Id" >
    <div class="card w-100 m-1">
        <div class="card-header d-flex align-items-center p-0">
            
            <!-- Left side -->
            <a asp-action="View" asp-route-id="@note.Id" class="btn btn-outline-secondary me-2">View</a>
            <a asp-action="Update" asp-route-id="@note.Id" class="btn btn-outline-secondary me-2">Edit</a>
            <span class="badge bg-secondary me-2">Tag 1</span>
            <span class="badge bg-secondary">Tag 1</span>
            <!-- Spacer pushes right -->
            <div class="ms-auto">
                <button class="btn btn-danger" asp-route-id="@note.Id" type="submit" asp-action="Delete" >Delete</button>
            </div>
            

        </div>
        <div class="card-body">
            <div class="card-title fw-bold m-0 p-0">@note.Name</div>
            <div class="card-text m-0 p-0">@note.Content.Left(50)</div>
        </div>
        <div class="card-footer">
        </div>
    </div>
    </form>
}
